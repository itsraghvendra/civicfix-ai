# Groq API Configuration (Backend AI inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Turnstile CAPTCHA Configuration
# If unconfigured, server-side cryptographic fallback challenge is used when suspicious activity is detected
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_REQUIRED_ALWAYS=false

# Passwordless Mobile OTP Configuration
# Set to 'true' if phone verification is mandatory for complaint submission
OTP_REQUIRED=false
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# SMS Provider Adapter: "demo" (logs OTP to console/demo note), "twilio", "fast2sms", or "none"
SMS_PROVIDER=demo

# Twilio SMS Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS Credentials (Optional - India)
FAST2SMS_API_KEY=

# Server Secret Key & Storage Configuration
SECRET_KEY=civicfix-secret-salt-lucknow-2026-prototype
# DATA_DIR=/var/data   # Set on Render Starter plan with Persistent Disk

# Rate Limiting Configuration (Per client identifier / phone)
RATE_LIMIT_SUBMISSION_MAX=5
RATE_LIMIT_SUBMISSION_WINDOW=600
RATE_LIMIT_OTP_REQUEST_MAX=3
RATE_LIMIT_OTP_REQUEST_WINDOW=600
OTP_RESEND_COOLDOWN_SECONDS=60
